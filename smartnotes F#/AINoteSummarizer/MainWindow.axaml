<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AINoteSummarizer.MainWindow"
    Title="NoteAI"
    Width="1250"
    Height="760"
    MinWidth="950"
    MinHeight="650"
    WindowStartupLocation="Center">

    <Window.Styles>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#14161B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#242731"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Styles>

    <Grid
        Background="#101114"
        RowDefinitions="Auto,Auto,*,Auto"
        Margin="35">

        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,30">

            <StackPanel>

                <StackPanel Orientation="Horizontal">

                    <Border
                        Width="42"
                        Height="42"
                        Background="#7C5CFC"
                        CornerRadius="12"
                        Margin="0,0,14,0">

                        <TextBlock
                            Text="✦"
                            Foreground="White"
                            FontSize="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel>

                        <TextBlock
                            Text="NoteAI"
                            Foreground="#F4F4F5"
                            FontSize="27"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Inteligentny skrót Twoich notatek"
                            Foreground="#9296A3"
                            FontSize="13"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

            <Border
                HorizontalAlignment="Right"
                Background="#191B21"
                BorderBrush="#292C35"
                BorderThickness="1"
                CornerRadius="20"
                Padding="14,8">

                <StackPanel Orientation="Horizontal">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="#4ADE80"
                        Margin="0,0,8,0"/>

                    <TextBlock
                        Text="AI Online"
                        Foreground="#A1A1AA"
                        FontSize="12"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- TOOLBAR -->

        <Grid
            Grid.Row="1"
            Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal">

                <TextBlock
                    Text="Skróć notatkę"
                    Foreground="#F4F4F5"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="  •  "
                    Foreground="#555866"
                    FontSize="18"/>

                <TextBlock
                    Text="AI-powered"
                    Foreground="#8B78FF"
                    FontSize="14"/>

            </StackPanel>

            <TextBlock
                Text="Gotowy do pracy"
                HorizontalAlignment="Right"
                Foreground="#717582"
                FontSize="12"/>

        </Grid>

        <!-- MAIN -->

        <Grid Grid.Row="2"
              ColumnDefinitions="*,24,*">

            <!-- INPUT -->

            <Border
                Grid.Column="0"
                Background="#191B21"
                BorderBrush="#292C35"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22">

                <Grid
                    RowDefinitions="Auto,*,Auto">

                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,16">

                        <TextBlock
                            Text="📄  Twoja notatka"
                            Foreground="#E4E4E7"
                            FontSize="15"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Name="InputCounter"
                            Text="0 znaków"
                            HorizontalAlignment="Right"
                            Foreground="#686D7A"
                            FontSize="12"/>

                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="#14161B"
                        CornerRadius="12">

                        <TextBox
                            Name="InputTextBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"/>

                    </Border>

                    <Grid
                        Grid.Row="2"
                        Margin="0,18,0,0">

                        <TextBlock
                            Text="Wklej tekst, który chcesz skrócić"
                            Foreground="#686D7A"
                            FontSize="12"
                            VerticalAlignment="Center"/>

                        <Button
                            Name="ClearButton"
                            Content="WYCZYŚĆ"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#8B78FF"/>

                    </Grid>

                </Grid>

            </Border>

            <!-- SPACER -->

            <Border Grid.Column="1"/>

            <!-- OUTPUT -->

            <Border
                Grid.Column="2"
                Background="#191B21"
                BorderBrush="#292C35"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22">

                <Grid
                    RowDefinitions="Auto,*,Auto">

                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,16">

                        <TextBlock
                            Text="✨  Skrócona notatka"
                            Foreground="#E4E4E7"
                            FontSize="15"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="WYNIK AI"
                            HorizontalAlignment="Right"
                            Foreground="#8B78FF"
                            FontSize="11"
                            FontWeight="Bold"/>

                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="#14161B"
                        CornerRadius="12">

                        <TextBox
                            Name="OutputTextBox"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"/>

                    </Border>

                    <Grid
                        Grid.Row="2"
                        Margin="0,18,0,0">

                        <TextBlock
                            Text="AI zachowa najważniejsze informacje"
                            Foreground="#686D7A"
                            FontSize="12"
                            VerticalAlignment="Center"/>

                        <Button
                            Name="CopyButton"
                            Content="KOPIUJ"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#8B78FF"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- BOTTOM -->

        <Grid
            Grid.Row="3"
            Margin="0,25,0,0">

            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Długość skrótu:"
                    Foreground="#A1A1AA"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>

                <ComboBox
                    Name="LengthComboBox"
                    Width="170"
                    SelectedIndex="0">

                    <ComboBoxItem Content="Krótka"/>
                    <ComboBoxItem Content="Średnia"/>
                    <ComboBoxItem Content="Szczegółowa"/>

                </ComboBox>

                <TextBlock
                    Name="StatusTextBlock"
                    Text="Gotowe"
                    Foreground="#686D7A"
                    FontSize="12"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <Button
                Name="SummarizeButton"
                Content="✦  SKRÓĆ ZA POMOCĄ AI"
                HorizontalAlignment="Right"
                Width="230"
                Height="48"
                Background="#7C5CFC"
                Foreground="White"/>

        </Grid>

    </Grid>

</Window>
