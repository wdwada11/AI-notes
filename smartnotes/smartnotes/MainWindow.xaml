 <Window x:Class="AINoteSummarizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteAI"
        Height="760"
        Width="1250"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#101114">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#101114"/>
        <SolidColorBrush x:Key="CardBrush" Color="#191B21"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#292C35"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9296A3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#14161B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#242731"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="170"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,30">

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#7C5CFC"
                            Width="42"
                            Height="42"
                            CornerRadius="12"
                            Margin="0,0,14,0">

                        <TextBlock Text="✦"
                                   Foreground="White"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="NoteAI"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="27"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Inteligentny skrót Twoich notatek"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    Background="#191B21"
                    BorderBrush="#292C35"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,8">

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#4ADE80"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="AI Online"
                               Foreground="#A1A1AA"
                               FontSize="12"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- TOOLBAR -->
        <Grid Grid.Row="1" Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Skróć notatkę"
                           Foreground="#F4F4F5"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="  •  "
                           Foreground="#555866"
                           FontSize="18"
                           VerticalAlignment="Center"/>

                <TextBlock Text="AI-powered"
                           Foreground="#8B78FF"
                           FontSize="14"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <TextBlock Text="Gotowy do pracy"
                       HorizontalAlignment="Right"
                       Foreground="#717582"
                       FontSize="12"
                       VerticalAlignment="Center"/>

        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- INPUT CARD -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">

                        <TextBlock Text="📄  Twoja notatka"
                                   Foreground="#E4E4E7"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="InputCounter"
                                   Text="0 znaków"
                                   HorizontalAlignment="Right"
                                   Foreground="#686D7A"
                                   FontSize="12"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Background="#14161B"
                            CornerRadius="12"
                            Padding="2">

                        <TextBox x:Name="InputTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 TextChanged="InputTextBox_TextChanged"
                                 BorderThickness="0"/>

                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">

                        <TextBlock Text="Wklej tekst, który chcesz skrócić"
                                   Foreground="#686D7A"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <Button Content="WYCZYŚĆ"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="#8B78FF"
                                BorderThickness="0"
                                Click="ClearButton_Click"/>

                    </Grid>

                </Grid>

            </Border>

            <!-- OUTPUT CARD -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">

                        <TextBlock Text="✨  Skrócona notatka"
                                   Foreground="#E4E4E7"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="WYNIK AI"
                                   HorizontalAlignment="Right"
                                   Foreground="#8B78FF"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                    </Grid>

                    <Border Grid.Row="1"
                            Background="#14161B"
                            CornerRadius="12"
                            Padding="2">

                        <TextBox x:Name="OutputTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 BorderThickness="0"/>

                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">

                        <TextBlock Text="AI zachowa najważniejsze informacje"
                                   Foreground="#686D7A"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <Button Content="KOPIUJ"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="#8B78FF"
                                BorderThickness="0"
                                Click="CopyButton_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- BOTTOM BAR -->
        <Grid Grid.Row="3" Margin="0,25,0,0">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Długość skrótu:"
                           Foreground="#A1A1AA"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <ComboBox x:Name="LengthComboBox"
                          SelectedIndex="0">

                    <ComboBoxItem Content="Krótka"/>
                    <ComboBoxItem Content="Średnia"/>
                    <ComboBoxItem Content="Szczegółowa"/>

                </ComboBox>

                <TextBlock x:Name="StatusTextBlock"
                           Text="Gotowe"
                           Foreground="#686D7A"
                           FontSize="12"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <Button x:Name="SummarizeButton"
                    Content="✦  SKRÓĆ ZA POMOCĄ AI"
                    HorizontalAlignment="Right"
                    Width="230"
                    Height="48"
                    Background="#7C5CFC"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SummarizeButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="15">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>

    </Grid>

</Window>